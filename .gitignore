# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Playwright output. Untracked and unignored, it would be swept up by `git add -A`.
/test-results
/playwright-report
# A saved signed-in session. A real cookie — never commit it.
/tests/e2e/.auth

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# planning
plan.md
handoff.md

# Generated by `npx tsx scripts/sample-history.ts`. Reproducible from the
# script, and not real data — nothing here belongs in the history.
/sample-data

# Accidental artefact of a mangled shell redirect (the filename is a path)
D*ProjectsCMStest.txt
