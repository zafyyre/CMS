# Copy to .env and adjust. .env is git-ignored; never commit it.
#
# ─────────────────────────────────────────────────────────────────────────────
# PORTS
# Postgres is published on 5433, not 5432, because this machine already runs a
# native PostgreSQL 18 Windows service bound to 0.0.0.0:5432 which shadows
# Docker's mapping. On a machine with no native Postgres, 5432 is fine — but
# change it in BOTH this file and docker-compose.yml.
# ─────────────────────────────────────────────────────────────────────────────

# --- Application connection --------------------------------------------------
# Docker uses this only to bootstrap the PostgreSQL superuser. Generate a
# URL-safe value, paste it here, then use the same value in both seed URLs:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leaving it empty is intentional: Docker Compose fails closed rather than
# launching a database with a documented password.
POSTGRES_SUPERUSER_PASSWORD=

# The app connects as app_user: not a superuser, no BYPASSRLS, owns no tables.
# That is exactly what makes row-level security bind to it. If you hit a
# permission error, fix the GRANT — do NOT "fix" it by switching to postgres,
# because superusers bypass RLS entirely and your isolation silently vanishes.
POSTGRES_URL=postgresql://app_user:app_local_pw@localhost:5433/cms

# --- Migrations --------------------------------------------------------------
# Runs as migrator, which owns the tables. Never used to serve a request.
MIGRATION_DATABASE_URL=postgresql://migrator:migrator_local_pw@localhost:5433/cms

# --- Tests -------------------------------------------------------------------
# A separate database, so a test that truncates cannot destroy your dev data.
TEST_DATABASE_URL=postgresql://app_user:app_local_pw@localhost:5433/cms_test
TEST_MIGRATION_DATABASE_URL=postgresql://migrator:migrator_local_pw@localhost:5433/cms_test

# --- Seeding (scripts only; deliberately NOT read by src/env.ts) -------------
# Creating a league is an operational act: app_user has no INSERT policy on
# organizations, by design. Seeding therefore connects as the superuser, which
# bypasses RLS. The application can never use these because env.ts omits them.
# Replace both placeholders with POSTGRES_SUPERUSER_PASSWORD before using a
# seed command. They are not interpolated by dotenv.
SEED_DATABASE_URL=postgresql://postgres:replace-with-your-generated-superuser-password@localhost:5433/cms
TEST_SEED_DATABASE_URL=postgresql://postgres:replace-with-your-generated-superuser-password@localhost:5433/cms_test

# --- Redis (used from Phase 7; declared now so config stays stable) ----------
REDIS_URL=redis://localhost:6379

# --- Auth --------------------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-me-with-32-bytes-of-base64-randomness
BETTER_AUTH_URL=http://localhost:3000

# --- Tenancy -----------------------------------------------------------------
# Each league gets its own hostname in production and the org is resolved from
# the Host header. localhost carries no tenant information, so it falls back.
DEFAULT_ORG_SLUG=kelowna

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=CMS
